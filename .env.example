# ---- SocialScope AI ------------------------------------------------------
# This file is intentionally committed. It contains NO real credentials and
# documents every variable the backend reads. Copy it to `.env` and fill in
# only what you need:
#   Copy-Item .env.example .env
# `.env` is listed in .gitignore and must never be committed.

# ---- Application ---------------------------------------------------------
ENVIRONMENT=development
DEBUG=false
# Change this before any deployment beyond local development.
SECRET_KEY=change-me-in-production

# ---- Platform API credentials -------------------------------------------
# Live analysis is refused with a clear message until the relevant key is set.
# Nothing here is ever sent to the browser.

# YouTube Data API v3 — https://console.cloud.google.com
YOUTUBE_API_KEY=

# Meta Graph API long-lived access token (Facebook Page and/or Instagram
# professional account).
FACEBOOK_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=

# Optional: skip the /me/accounts lookup by pinning the IDs directly.
INSTAGRAM_ACCOUNT_ID=
FACEBOOK_PAGE_ID=

META_API_VERSION=v21.0

# ---- Database ------------------------------------------------------------
# Leave DATABASE_URL empty to use the local SQLite file at data/socialscope.db.
# For PostgreSQL:
#   pip install "psycopg[binary]>=3.2"
#   DATABASE_URL=postgresql+psycopg://socialscope:password@localhost:5432/socialscope
DATABASE_URL=

# ---- CORS ----------------------------------------------------------------
# Comma-separated frontend origins, no trailing slash.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Rate limiting and collection limits --------------------------------
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
REQUEST_TIMEOUT_SECONDS=20
# Each commentThreads page costs 1 unit of the standard YouTube quota.
MAX_COMMENT_PAGES=5
COMMENTS_PER_PAGE=100

# ---- Analysis ------------------------------------------------------------
# auto | vader | lexicon. TextBlob is used for comparison whenever installed.
SENTIMENT_BACKEND=auto

# Set to false to remove the bundled synthetic demo dataset entirely.
ENABLE_DEMO_MODE=true

# ---- Frontend (build-time, Vite) ----------------------------------------
# Leave unset to use the dev-server proxy at /api. For a deployed build, set it
# to the public API base, e.g. https://api.example.com/api
VITE_API_URL=
