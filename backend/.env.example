# ---------------------------------------------------------------------------
# SocialScope AI — backend environment configuration
#
# Copy this file to `.env` and fill in the values you need.
#   Copy-Item .env.example .env
#
# NEVER commit `.env` or any real credential to version control.
# ---------------------------------------------------------------------------

# ---- Application ----------------------------------------------------------
ENVIRONMENT=development
DEBUG=false
SECRET_KEY=change-me-in-production

# ---- Platform API credentials --------------------------------------------
# Live analysis requires a credential for the platform you analyse.
# Without one, /api/analyze returns a clear "not configured" error and the app
# directs you to the clearly-labelled demo analysis instead.

# YouTube Data API v3 key.
# Create a project in Google Cloud Console, enable "YouTube Data API v3", then
# create an API key.
YOUTUBE_API_KEY=

# Meta Graph API long-lived access token (Facebook Page / Instagram).
# Required for both the Facebook and Instagram adapters. Generate it from a Meta
# app that owns the Page or the professional (Business/Creator) account.
FACEBOOK_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=

# Optional: skip the /me/accounts lookup by pinning the IDs directly.
INSTAGRAM_ACCOUNT_ID=
FACEBOOK_PAGE_ID=

META_API_VERSION=v21.0

# ---- Database -------------------------------------------------------------
# Defaults to a local SQLite file at ../data/socialscope.db
# For PostgreSQL, install the driver first:
#   pip install "psycopg[binary]>=3.2"
#   pip install "sqlalchemy>=2.0" "psycopg[binary]>=3.2"
# then set:
# DATABASE_URL=postgresql+psycopg://socialscope:password@localhost:5432/socialscope
DATABASE_URL=

# ---- CORS -----------------------------------------------------------------
# Comma-separated list of allowed frontend origins (no trailing slash).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Rate limiting --------------------------------------------------------
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# ---- Collection limits ----------------------------------------------------
REQUEST_TIMEOUT_SECONDS=20
# Comment pages fetched per analysis. Each commentThreads page costs 1 unit of
# the standard YouTube quota, so raise this only if you have quota to spare.
MAX_COMMENT_PAGES=5
COMMENTS_PER_PAGE=100

# ---- Analysis -------------------------------------------------------------
# auto | vader | lexicon   (textblob is always used for comparison when installed)
SENTIMENT_BACKEND=auto

# Set to false to disable the bundled synthetic demo dataset entirely.
ENABLE_DEMO_MODE=true
