# ---- Secrets and local configuration -------------------------------------
# Never commit credentials. Only *.example files are tracked.
.env
.env.*
!.env.example
backend/.env
frontend/.env
*.pem
*.key

# ---- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- Node / frontend ------------------------------------------------------
node_modules/
frontend/dist/
frontend/.vite/
frontend/node_modules/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---- Application data ----------------------------------------------------
# The SQLite database, collected raw snapshots and generated exports are
# runtime artefacts, not source.
data/*.db
data/*.sqlite
data/*.sqlite3
data/raw/*
data/cleaned/*
data/exports/*
data/demo/*
!data/raw/.gitkeep
!data/cleaned/.gitkeep
!data/exports/.gitkeep
!data/demo/.gitkeep

# ---- Logs and process files ----------------------------------------------
*.log
*.err
logs/
server.log
server.err
dev.log
dev.err
.pid

# ---- Generated documentation and reports ---------------------------------
docs/build/
*.pdf
!docs/*.pdf

# ---- Editors and OS -------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
